# Copy to .env to run in live mode. Leave empty to run the on-device demo.

# Supabase project (Project settings > API)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Stripe publishable key (pk_test_... or pk_live_...)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Set to 1 once Apple Pay / Google Pay are configured for your Stripe account
EXPO_PUBLIC_STRIPE_WALLETS=0
# Two-letter country of your Stripe account, used by Apple Pay / Google Pay
EXPO_PUBLIC_STRIPE_MERCHANT_COUNTRY=US

{
  "expo": {
    "name": "Somali Airlines",
    "slug": "somali-airlines-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "somaliairlines",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.amiinstudio.somaliairlines",
      "supportsTablet": true
    },
    "android": {
      "package": "com.amiinstudio.somaliairlines",
      "adaptiveIcon": {
        "backgroundColor": "#1F5FAE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F5FAE",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.amiinstudio.somaliairlines",
          "enableGooglePay": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}

<UserControl x:Class="Amiin.Views.StatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid Background="#101318">
        <Grid.Resources>
            <Storyboard x:Key="SpinStoryboard">
                <DoubleAnimation Storyboard.TargetName="SpinnerRotate" Storyboard.TargetProperty="Angle"
                                  From="0" To="360" Duration="0:0:1.1" RepeatBehavior="Forever"/>
            </Storyboard>
        </Grid.Resources>
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard Storyboard="{StaticResource SpinStoryboard}"/>
            </EventTrigger>
        </Grid.Triggers>

        <Ellipse Width="600" Height="600" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-200,-200,0,0" Opacity="0.045">
            <Ellipse.Fill>
                <RadialGradientBrush><GradientStop Color="#FF7A1A" Offset="0"/><GradientStop Color="#00FF7A1A" Offset="1"/></RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="600" Height="600" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-200,-200" Opacity="0.045">
            <Ellipse.Fill>
                <RadialGradientBrush><GradientStop Color="#E8352B" Offset="0"/><GradientStop Color="#00E8352B" Offset="1"/></RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <StackPanel Width="480" HorizontalAlignment="Center" VerticalAlignment="Center">

            <Border Background="White" CornerRadius="16" Padding="14,9" HorizontalAlignment="Center" Margin="0,0,0,28">
                <Image Source="pack://siteoforigin:,,,/Assets/amiin-logo.png" Height="34" Stretch="Uniform"/>
            </Border>

            <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Subtitle}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,6,0,32"/>

            <!-- Determinate progress (Installing / Updating) -->
            <StackPanel Visibility="{Binding ShowProgressBar, Converter={StaticResource BoolToVis}}">
                <ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="100"
                             Style="{StaticResource LauncherProgressBarStyle}" IsIndeterminate="{Binding IsIndeterminate}"/>
                <Grid Margin="0,8,0,24">
                    <TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0:F0}%'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                </Grid>

                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="SPEED" FontSize="10" Foreground="{StaticResource TextFaintBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding SpeedText}" FontSize="13" FontWeight="Bold" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="SIZE" FontSize="10" Foreground="{StaticResource TextFaintBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding SizeText}" FontSize="13" FontWeight="Bold" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="TIME LEFT" FontSize="10" Foreground="{StaticResource TextFaintBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding TimeLeftText}" FontSize="13" FontWeight="Bold" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource GhostButtonStyle}" Command="{Binding TogglePauseCommand}" Padding="16,9" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPauseBars}" Style="{StaticResource LineIconStyle}" Width="13" Height="13"/>
                            <TextBlock Text="{Binding IsPaused, Converter={StaticResource PauseLabelConverter}}" Margin="6,0,0,0" FontSize="13"/>
                        </StackPanel>
                    </Button>
                    <Button Content="Cancel" Style="{StaticResource TextLinkButtonStyle}" Command="{Binding CancelCommand}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Indeterminate (Launching) -->
            <StackPanel Visibility="{Binding ShowSpinner, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center">
                <Grid Width="52" Height="52" Margin="0,0,0,20">
                    <Ellipse Width="52" Height="52" Stroke="{StaticResource Panel2Brush}" StrokeThickness="4"/>
                    <Path Width="52" Height="52" Stroke="{StaticResource BrandOrangeBrush}" StrokeThickness="4" StrokeStartLineCap="Round"
                          Data="M26,2 A24,24 0 0 1 50,26" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                        </Path.RenderTransform>
                    </Path>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource BrandOrangeBrush}" Margin="0,0,8,0"/>
                    <Ellipse Width="8" Height="8" Fill="{StaticResource BrandOrangeBrush}" Opacity="0.6" Margin="0,0,8,0"/>
                    <Ellipse Width="8" Height="8" Fill="{StaticResource BrandOrangeBrush}" Opacity="0.3"/>
                </StackPanel>
                <Button Content="Cancel" Style="{StaticResource TextLinkButtonStyle}" Command="{Binding CancelCommand}" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Error -->
            <StackPanel Visibility="{Binding ShowError, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center">
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,20">
                    <TextBlock Text="{Binding ErrorMessage}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" MaxWidth="440" TextAlignment="Center"/>
                </Border>
                <Button Content="Close" Style="{StaticResource GhostButtonStyle}" Command="{Binding DismissCommand}" HorizontalAlignment="Center" Padding="24,9"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</UserControl>

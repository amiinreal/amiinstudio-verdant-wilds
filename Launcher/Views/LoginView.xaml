<UserControl x:Class="Amiin.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             mc:Ignorable="d" Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Brand side -->
        <Border Grid.Column="0" Background="{StaticResource PanelBrush}">
            <Grid>
                <Rectangle Fill="{StaticResource ForestSkyBrush}" Opacity="0.5"/>
                <Rectangle Fill="{StaticResource SunGlowBrush}"/>
                <StackPanel VerticalAlignment="Center" Margin="64">
                    <Border Background="White" CornerRadius="10" Padding="10,6" HorizontalAlignment="Left" Margin="0,0,0,32">
                        <Image Source="pack://siteoforigin:,,,/Assets/amiin-logo.png" Height="26" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="AMIIN STUDIO" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource GameGoldBrush}" Margin="0,0,0,16"/>
                    <TextBlock Text="Your games. Your worlds. Your friends." FontFamily="{StaticResource DisplayFont}" FontSize="40" FontWeight="ExtraBold"
                               Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <TextBlock Text="One account unlocks every Amiin Studio game — starting with The Verdant Wilds." FontSize="15"
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="440"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Form side -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="56" MaxWidth="380" HorizontalAlignment="Left">

            <TextBlock Text="Sign in to continue" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,24"
                       Visibility="{Binding IsRecoveryMode, Converter={StaticResource BoolToVisInverse}}"/>
            <TextBlock Text="Recover your account" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,24"
                       Visibility="{Binding IsRecoveryMode, Converter={StaticResource BoolToVis}}"/>

            <TextBlock Text="EXPLORER NAME" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource GameGoldBrush}" Margin="0,0,0,6"/>
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Height="42" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

            <TextBlock Text="PASSWORD · at least 12 characters" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource GameGoldBrush}" Margin="0,14,0,6"/>
            <PasswordBox x:Name="PasswordInput" Height="42" shell:WindowChrome.IsHitTestVisibleInChrome="True" PasswordChanged="PasswordInput_PasswordChanged"/>

            <TextBlock Text="RECOVERY CODE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource GameGoldBrush}" Margin="0,14,0,6"
                       Visibility="{Binding IsRecoveryMode, Converter={StaticResource BoolToVis}}"/>
            <TextBox Text="{Binding RecoveryCode, UpdateSourceTrigger=PropertyChanged}" Height="42" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                     Visibility="{Binding IsRecoveryMode, Converter={StaticResource BoolToVis}}"/>

            <Grid Margin="0,18,0,0" Visibility="{Binding IsRecoveryMode, Converter={StaticResource BoolToVisInverse}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Sign in" Style="{StaticResource PrimaryButtonStyle}" Height="44"
                        Command="{Binding SignInCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource BoolInverse}}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button Grid.Column="1" Content="Create account" Style="{StaticResource GhostButtonStyle}" Height="44" Margin="8,0,0,0"
                        Command="{Binding CreateAccountCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource BoolInverse}}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>

            <Button Content="Reset password" Style="{StaticResource PrimaryButtonStyle}" Height="44" Margin="0,18,0,0" HorizontalAlignment="Left" Padding="24,12"
                    Command="{Binding ConfirmRecoveryCommand}" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Visibility="{Binding IsRecoveryMode, Converter={StaticResource BoolToVis}}"/>

            <Button Content="{Binding RecoveryToggleLabel}" Style="{StaticResource TextLinkButtonStyle}" HorizontalAlignment="Left" Margin="0,10,0,0"
                    Command="{Binding ToggleRecoveryCommand}" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,14,0,0" FontSize="13"
                       Foreground="{Binding StatusIsError, Converter={StaticResource ErrorColorConverter}}"
                       Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}"/>

            <TextBlock Text="{Binding DevBanner}" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource GameGoldBrush}"
                       Visibility="{Binding DevBanner, Converter={StaticResource StringToVis}}"/>

            <TextBlock Text="{Binding VersionLabel}" FontSize="11" Foreground="{StaticResource TextFaintBrush}" Margin="0,28,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>AmiinLauncher</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <!-- Kept in sync with Updates.Version (the constant the update pipeline actually
         compares against); see Updates.cs. Bump both together. -->
    <Version>0.3.0</Version>
    <FileVersion>0.3.0.0</FileVersion>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <InformationalVersion>0.3.0</InformationalVersion>

    <Product>Amiin Studio Launcher</Product>
    <AssemblyTitle>Amiin Studio Launcher</AssemblyTitle>
    <Company>Amiin Studio</Company>
    <Authors>Amiin Studio</Authors>
    <Description>Official launcher for Amiin Studio games, including The Verdant Wilds. Signs in, checks for signed updates, and launches the selected game.</Description>
    <Copyright>Copyright (c) 2026 Amiin Studio</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <ApplicationIcon>launcher.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.cs"/>
    <Compile Include="Updates.cs"/>
    <Compile Include="Models/*.cs"/>
    <Compile Include="Converters/*.cs"/>
    <Compile Include="Services/*.cs"/>
    <Compile Include="ViewModels/*.cs"/>
    <Compile Include="MainWindow.xaml.cs"/>
    <Compile Include="Views/*.xaml.cs"/>
  </ItemGroup>
  <ItemGroup>
    <Page Include="MainWindow.xaml"/>
    <Page Include="Views/*.xaml"/>
    <Page Include="Styles/*.xaml"/>
  </ItemGroup>
  <ItemGroup>
    <Content Include="../Logo/X8y06N.png" Link="Assets/amiin-logo.png" CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="launcher-config.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('launcher-config.json')"/>
  </ItemGroup>
</Project>
